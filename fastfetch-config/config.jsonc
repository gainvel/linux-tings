{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "",
        "color": {
            "1": "white"
        }
    },
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[37m", "\u001b[37m", "\u001b[37m", "\u001b[37m"]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "os",
            "key": "│ distro ",
            "format": "{pretty-name>24} │"
        },
        {
            "type": "kernel",
            "key": "│ kernel ",
            "format": "{release>24} │"
        },
        {
            "type": "command",
            "key": "│ uptime ",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{>24} │"
        },
        {
            "type": "de",
            "key": "│ de  ",
            "format": "{pretty-name>27} │"
        },
        {
            "type": "terminal",
            "key": "│ terminal  ",
            "format": "{pretty-name>21} │"
        },
        {
            "type": "command",
            "key": "│ mem    ",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{>24} │"
        },
        {
            "type": "command",
            "key": "│ vmem     ",
            "text": "awk '{printf \" %5.2f GiB\", $1/1073741824}' /sys/class/drm/card1/device/mem_info_vram_used; echo -n \" / \"; awk '{printf \"%.2f GiB │\", $1/1073741824}' /sys/class/drm/card1/device/mem_info_vram_total"
        },
        {
            "type": "disk",
            "key": "│ disk   ",
            "format": "{size-used>13} / {size-total} │"
        },
        {
            "type": "packages",
            "key": "│ pkgs   ",
            "format": "{all>24} │"

        },
        {
            "type": "gpu",
            "key": "│ gpu    ",
            "temp": true,
            "format": "{name>24} │",
            "hideType": "integrated",
        },
        {
            "type": "cpu",
            "key": "│ cpu",
            "temp": true,
            "format": "{name>23} {cores-physical}|{cores-logical} │",

        },
        {
            "type": "board",
            "key": "│ mb",
            "format": "{name>29} │"
        },
        {
            "type": "physicaldisk",
            "key": "│ disk   ",
            "format": "{name>24} │"
        },
        {
            "type": "command",
            "key": "│ mouse   ",
            "text": "echo 'Razer Viper V2 Pro'",
            "format": "{1>23} │"
        },
        {
            "type": "command",
            "key": "│ keyboard",
            "text": "echo 'Bridge75'",
            "format": "{1>23} │"
        },
        {
            "type": "display",
            "key": "│ monitor",
            "format": " {height}p|{refresh-rate}hz{name>12} │"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}
